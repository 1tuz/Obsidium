{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Obsidium",
  "version": "0.2.6",
  "identifier": "com.dmitriy.aquilum-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run icons:sync && npm run build",
    "frontendDist": "../../.artifacts/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Obsidium",
        "width": 1000,
        "height": 600,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": "default-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws: wss: https:; font-src 'self' data: blob:; img-src 'self' asset: http://asset.localhost data: blob: https:; media-src 'self' asset: http://asset.localhost blob: https:; frame-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/1tuz/Obsidium/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCMTgwNkE4QjhEQzY2QjkKUldTNVp0eTRxQVlZbTBYa2F2UXhDcGFJa2VKdHJCVzUwMG1KOTF6dWJPdkJHNGtmSzVkVk83VWcK",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
